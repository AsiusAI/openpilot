Import('env', 'arch', 'messaging', 'common', 'visionipc', 'ASIUS_HARDWARE')

libs = [common, messaging, visionipc]

if arch != "Darwin":
  camera_obj = env.Object(['cameras/camera_v1.cc', 'sensors/os04c10.cc'] if ASIUS_HARDWARE else
      ['cameras/camera_qcom2.cc', 'cameras/camera_common.cc', 'cameras/spectra.cc', 'cameras/cdm.cc', 'sensors/ox03c10.cc', 'sensors/os04c10.cc'])
  env.Program('camerad', ['main.cc', camera_obj], LIBS=libs)
